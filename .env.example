# URL del backend Nest (equivale a `baseURLApiGateway` en Angular).
# Desarrollo: http://localhost:3000
# Producción: https://business-manager-nest-production.up.railway.app
BASE_URL_API_GATEWAY=http://localhost:3000

# URL del panel de Noduza (proyecto Angular): a donde llevan los botones de registro e inicio de sesión de la landing.
# Desarrollo: http://localhost:4200
# Producción: https://noduza.com (valor por defecto si no se define)
NODUZA_APP_URL=http://localhost:4200
